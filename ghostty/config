# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

config-file = theme
custom-shader = shaders/cursor_blaze.glsl
custom-shader = shaders/cursor_trail.glsl
custom-shader = shaders/bloom.glsl

font-family = Hack Nerd Font
font-size = 13
adjust-underline-position = 3
adjust-cursor-thickness = 4
window-vsync = true

window-decoration = false
window-theme = auto
macos-titlebar-style = hidden
macos-auto-secure-input = true
macos-window-shadow = false
macos-secure-input-indication = true
macos-option-as-alt = left
shell-integration = zsh
shell-integration-features = sudo

window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-padding-color = extend

quit-after-last-window-closed = true

keybind = cmd+shift+f=write_screen_file:paste
keybind = cmd+shift+j=unbind
keybind = cmd+w=unbind

# disable tabs
keybind = super+physical:four=unbind
keybind = super+shift+left_bracket=unbind
keybind = super+alt+w=unbind
keybind = super+physical:eight=unbind
keybind = super+t=unbind
keybind = super+shift+right_bracket=unbind
keybind = super+physical:one=unbind
keybind = super+physical:three=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = super+physical:nine=unbind
keybind = super+physical:five=unbind
keybind = super+physical:seven=unbind
keybind = super+physical:two=unbind
keybind = super+physical:six=unbind
keybind = shift+enter=text:\n


